+    if (!e) return false;
+    const msg = e.message || String(e);
+    return (
+        msg.includes('cached state') ||
+        msg.includes('state has changed') ||
+        e.name === 'InvalidStateError' ||
+        e.name === 'NoModificationAllowedError'
+    );
+}
